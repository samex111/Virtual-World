# Virtual-World only accepts an explicitly designated test environment.
TARGET_ENVIRONMENT=test

# Replace these placeholders with the exact Aceraa QA/staging origin.
# Never use the public/production Aceraa URL.
TARGET_BASE_URL=https://replace-with-aceraa-test-host.example
TARGET_ALLOWED_HOSTS=replace-with-aceraa-test-host.example
TARGET_SAFETY_ACK=I_CONFIRM_THIS_IS_A_DEDICATED_TEST_ENVIRONMENT

# Set true only after the Aceraa owner provisions and verifies a synthetic account.
TEST_ACCOUNT_READY=false
TEST_ACCOUNT_KIND=synthetic
TEST_ACCOUNT_EMAIL=
TEST_ACCOUNT_PASSWORD=

# Target-specific adapter is local, created only after reviewing the authenticated QA UI.
PHASE1_ADAPTER_MODULE=./local/aceraa-phase1-adapter.mjs
PHASE1_STUDENT_ID=student_jee_physics_001
PHASE1_ARTIFACTS_DIR=artifacts/phase-1
PHASE1_MAX_ACTIONS=20
PHASE1_MAX_DURATION_MS=180000
PHASE1_MAX_DECISION_CALLS=20
PHASE1_MAX_RETRIES=0
PHASE1_MAX_ACTION_TIMEOUT_MS=8000
PHASE1_MAX_DECISION_CALL_MS=15000

# Phase 0 output is local and gitignored.
VIRTUAL_WORLD_ARTIFACTS_DIR=artifacts/phase-0
